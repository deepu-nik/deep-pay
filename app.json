{
  "expo": {
    "name": "DeepPay",
    "slug": "deeppay",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "deeppay",
    "userInterfaceStyle": "automatic",
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow DeepPay to access your camera to scan UPI QR codes.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "android": {
      "softwareKeyboardLayoutMode": "resize"
    }
  }
}
